{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "summary",
          "topic",
          "tags",
          "kind",
          "updatedAt",
          "sources",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320,
            "pattern": "\\S"
          },
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "\\S"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "note",
              "course",
              "article",
              "video",
              "project"
            ]
          },
          "tags": {
            "type": "array",
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "\\S"
            }
          },
          "status": {
            "enum": [
              "draft",
              "published",
              "archived"
            ]
          },
          "sample": {
            "type": "boolean"
          },
          "contentPath": {
            "type": "string",
            "pattern": "^content/notes/[a-z0-9-]+\\.md$"
          },
          "sources": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "url",
                "type"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "\\S"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://",
                  "maxLength": 2048
                },
                "type": {
                  "enum": [
                    "original",
                    "repository",
                    "demo",
                    "reference"
                  ]
                }
              }
            }
          },
          "studiedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "updatedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "learningUrl": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 2048
          }
        }
      }
    }
  }
}
